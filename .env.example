# Thesis MCP Server — Configuration
# Copy this file to .env and modify as needed.

# Server port (default: 8899)
THESIS_MCP_PORT=8899

# Output directory for corrected files (default: ./output)
THESIS_OUTPUT_DIR=./output

# ---------- MinIO / S3 (optional) ----------
# If left empty, corrected files are saved locally only (no download link).
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=your_access_key
# MINIO_SECRET_KEY=your_secret_key
# MINIO_BUCKET=nexent
# MINIO_CORRECTIONS_PREFIX=corrections
# MINIO_EXTERNAL_HOST=10.242.187.87
